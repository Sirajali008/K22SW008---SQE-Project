{
  "info": {
    "name": "Student Management CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "TC-01 Create student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/students",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Ahmed\",\n  \"rollNo\": \"{{testRoll}}\",\n  \"department\": \"Software Engineering\",\n  \"semester\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testRoll', 'PBL-' + pm.variables.replaceIn('{{$guid}}').slice(0,18));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Response matches the expected data', () => {",
              "const expected = {name:'Ali Ahmed', rollNo:pm.collectionVariables.get('testRoll'), department:'Software Engineering', semester:1};",
              "const row = pm.response.json();",
              "pm.expect(row.id).to.be.a('number').and.above(0);",
              "pm.expect(pm.response.headers.get('Location')).to.equal('/api/students/' + row.id);",
              "pm.collectionVariables.set('studentId', String(row.id));",
              "pm.expect(row).to.deep.equal({...expected,id:Number(pm.collectionVariables.get('studentId'))});",
              "});"
            ]
          }
        }
      ]
    },
    {
